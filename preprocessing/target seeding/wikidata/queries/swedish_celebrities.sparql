PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?person ?personLabel ?sitelinks WHERE {
  ?svArticle schema:isPartOf <https://sv.wikipedia.org/> ;
             schema:about ?person .

  ?person wdt:P31 wd:Q5 ;        # instance of: human
          wdt:P27 wd:Q34 ;       # country of citizenship: Sweden
          wikibase:sitelinks ?sitelinks .

  # No birthDate gate: the old `>= 1990` cutoff silently excluded the entire
  # pre-1990 class (Zlatan 1981, Robyn 1979, ABBA…) and dropped humans with no
  # P569 at all. Obscurity is handled downstream by the stage_7 notability +
  # sv-pageviews gates. sitelinks > 4 keeps the result set tractable for WDQS
  # (the sv-article requirement already bounds it to people with a sv.wikipedia page).
  FILTER( ?sitelinks > 4 )

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "sv,en".
  }
}
# NO LIMIT, NO ORDER BY! Python will handle this!